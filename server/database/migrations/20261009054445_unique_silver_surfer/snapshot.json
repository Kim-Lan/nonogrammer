      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "jsonb_typeof(\"rowClues\") = 'array'",
      "name": "puzzle_row_clues_array",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "jsonb_typeof(\"columnClues\") = 'array'",
      "name": "puzzle_column_clues_array",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "jsonb_array_length(\"rowClues\") = \"height\" AND jsonb_array_length(\"columnClues\") = \"width\"",
      "name": "puzzle_clue_dimensions",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"type\" <> 'system' OR \"difficulty\" IS NOT NULL",
      "name": "system_puzzle_difficulty",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\n    (\"difficulty\" IS NULL AND \"solverMethod\" IS NULL)\n    OR (\"difficulty\" IS NOT NULL\n      AND \"solverMethod\" IS NOT NULL\n      AND (\n        (\"difficulty\" = 'normal' AND \"solverMethod\" = 'simple')\n        OR (\"difficulty\" = 'hard' AND \"solverMethod\" = 'four')\n      )\n    )\n  ",
      "name": "puzzle_difficulty_solver_consistency",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"simpleSolverSweepCount\" IS NULL OR \"simpleSolverSweepCount\" >= 0",
      "name": "simple_solver_sweep_count_nonnegative",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"fourSolverStepCount\" IS NULL OR \"fourSolverStepCount\" >= 0",
      "name": "four_solver_step_count_nonnegative",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"publicationStatus\" <> 'published' OR \"validationStatus\" = 'valid'",
      "name": "published_puzzle_valid",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"type\" <> 'system'\n    OR \"publicationStatus\" <> 'published'\n    OR (\n      \"difficulty\" IS NOT NULL\n      AND \"solverMethod\" IS NOT NULL\n      AND \"simpleSolverSweepCount\" IS NOT NULL\n      AND \"fourSolverStepCount\" IS NOT NULL\n    )\n  ",
      "name": "published_system_puzzle_solver_required",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\n    \"solverMethod\" IS NULL\n    OR (\n      \"solverMethod\" = 'simple'\n      AND \"simpleSolverSweepCount\" > 0\n      AND \"fourSolverStepCount\" = 0\n    )\n    OR (\n      \"solverMethod\" = 'four'\n      AND \"simpleSolverSweepCount\" >= 0\n      AND \"fourSolverStepCount\" > 0\n    )\n  ",
      "name": "puzzle_solver_step_consistency",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    }
