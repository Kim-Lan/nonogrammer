    {
      "value": "\"slug\" ~* '^[a-z0-9]([a-z0-9_-]*[a-z0-9])?$'",
      "name": "slug_format",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "char_length(\"slug\") >= 3",
      "name": "slug_min_length",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"height\" BETWEEN 5 AND 30",
      "name": "height_range",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"width\" BETWEEN 5 AND 30",
      "name": "width_range",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "length(\"solution_bits\") = \"height\" * \"width\"",
      "name": "solution_length",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"solution_bits\" ~ '^[01]+$'",
      "name": "binary_solution",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "jsonb_typeof(\"row_clues\") = 'array'",
      "name": "row_clues_array",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "jsonb_typeof(\"column_clues\") = 'array'",
      "name": "column_clues_array",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "jsonb_array_length(\"row_clues\") = \"height\" AND jsonb_array_length(\"column_clues\") = \"width\"",
      "name": "clue_dimensions",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\n    \"type\" NOT IN ('system', 'daily')\n    OR \"generator\" IS NOT NULL\n  ",
      "name": "generator_consistency",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\n    (\"difficulty\" IS NULL AND \"solver\" IS NULL)\n    OR (\n      \"difficulty\" IS NOT NULL\n      AND \"solver\" IS NOT NULL\n      AND (\n        (\"difficulty\" = 'normal' AND \"solver\" = 'simple')\n        OR (\"difficulty\" = 'hard' AND \"solver\" = 'four')\n      )\n    )\n  ",
      "name": "difficulty_solver_consistency",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"simple_solver_sweep_count\" >= 0",
      "name": "simple_solver_sweep_count_nonnegative",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"four_solver_intersection_count\" >= 0",
      "name": "four_solver_intersection_count_nonnegative",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\"publication_status\" <> 'published' OR \"validation_status\" = 'valid'",
      "name": "published_puzzle_valid",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\n    \"solver\" IS NULL\n    OR (\n      \"solver\" = 'simple'\n      AND \"simple_solver_sweep_count\" > 0\n      AND \"four_solver_intersection_count\" = 0\n    )\n    OR (\n      \"solver\" = 'four'\n      AND \"simple_solver_sweep_count\" >= 0\n      AND \"four_solver_intersection_count\" > 0\n    )\n  ",
      "name": "solver_sweep_intersection_consistency",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    },
    {
      "value": "\n    (\n      \"validation_status\" <> 'valid'\n      AND \"difficulty\" IS NULL\n      AND \"solver\" IS NULL\n      AND \"simple_solver_sweep_count\" IS NULL\n      AND \"four_solver_intersection_count\" IS NULL\n    )\n    OR (\n      \"validation_status\" = 'valid'\n      AND \"difficulty\" IS NOT NULL\n      AND \"solver\" IS NOT NULL\n      AND \"simple_solver_sweep_count\" IS NOT NULL\n      AND \"four_solver_intersection_count\" IS NOT NULL\n    )\n  ",
      "name": "validation_solver_consistency",
      "entityType": "checks",
      "schema": "public",
      "table": "puzzles"
    }
  ],
